// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDeConta {
  SENIOR_ADMIN
  ADMIN
  ENFERMEIRO
  RECEPCAO
}

enum TipoDeLocal {
  HOSPITAL
  CLINICA
  POSTO_DE_SAUDE
  LABORATORIO
  OUTRO
}

enum AtendimentoDentroOuForaDoMunicipio{
  DENTRO_DO_MUNICIPIO
  FORA_DO_MUNICIPIO
}

enum CategoriaEspecialidade {
  NORMAL
  TFD
}

enum TipoProcedimento {
  COMUM
  COM_MEMBROS
}

enum Lateralidade {
  SEM_LADO
  COM_LADO
}

enum TipoDoPrestador{
  MEDICO
  PRESTADOR_DE_SERVICOS_MEDICOS
}
enum PeriodoDeAtendimento{
  MANHA
  TARDE
  NOITE
}

enum Sexo{
  MASCULINO
  FEMININO
  NAO_INFORMADO
}

enum EstadoCivil{
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  NAO_INFORMADO
}

enum Raca{
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  NAO_INFORMADO
}

enum TipoSanguineo{
  A
  B
  AB
  O
}

enum FatorRH{
  POSITIVO
  NEGATIVO
}

enum UF{
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum GrauDeEscolaridade{
  NAO_ALFABETIZADO
  FUNDAMENTAL_INCOMPLETO
  FUNDAMENTAL_COMPLETO
  MEDIO_INCOMPLETO
  MEDIO_COMPLETO
  SUPERIOR_INCOMPLETO
  SUPERIOR_COMPLETO
  POS_GRADUACAO
}

enum TipoDeLogradouro{
  RUA
  AVENIDA
  ALAMEDA
  ESTRADA
  RODOVIA
  TRAVESSA
  PRACA
  OUTRO
}

enum Zona{
  URBANA
  RURAL
}

enum Deficiencia{
  FISICA
  VISUAL
  AUDITIVA
  INTELECTUAL
  MULTIPLA
  TEA
}

enum TipoDeCadastroPaciente{
  PROVISORIO
  COMPLETO
}

model Usuario {
  id                String   @id @default(cuid())
  nome              String
  email             String   @unique
  imagem            String?
  dataDeNascimento  DateTime?
  ativo             Boolean  @default(true)
  senhaHash         String
  tipoDeConta       TipoDeConta @default(SENIOR_ADMIN)

  localId Int?
  local   Local? @relation(fields: [localId], references: [id])
  agendamentosCriados AgendamentoDePrestador[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Local {
  id           Int       @id @default(autoincrement())

  nome         String
  tipoDeLocal  TipoDeLocal
  atendimentoDentroOuForaDoMunicipio         AtendimentoDentroOuForaDoMunicipio
  quantidadeDeSalas Int
  ativo        Boolean   @default(true)

  cidade       String
  cep          String
  uf           String

  rua          String
  numero       String
  bairro       String
  complemento  String?

  telefone1    String
  email        String?

  usuarios     Usuario[]
  agendamentos AgendamentoDePrestador[]
  pacientes    Paciente[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Especialidade {
  id        Int                       @id @default(autoincrement())
  nome      String                    @unique
  codigo    String                    @unique
  categoria CategoriaEspecialidade[]
  ativo     Boolean                   @default(true)

  prestadores PrestadorEspecialidade[]

  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
}

model Procedimento {
  id        Int             @id @default(autoincrement())
  nome      String          @unique
  codigo    String          @unique
  tipo      TipoProcedimento @default(COMUM)
  membros   MembroProcedimento[]

  prestadores PrestadorProcedimento[]

  ativo     Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model MembroProcedimento {
  id             Int          @id @default(autoincrement())
  nome           String
  lateralidade   Lateralidade @default(SEM_LADO)

  procedimentoId Int
  procedimento   Procedimento @relation(fields: [procedimentoId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([nome, procedimentoId])
}

model Prestador {
  id    Int           @id @default(autoincrement())
  nome  String
  tipo  TipoDoPrestador
  telefone String
  email String
  cor   String        @unique @db.VarChar(7)

  especialidades PrestadorEspecialidade[]
  procedimentos PrestadorProcedimento[]
  
  agendamentos AgendamentoDePrestador[]

  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PrestadorEspecialidade {
  prestadorId    Int
  especialidadeId Int

  prestador Prestador @relation(fields: [prestadorId],references: [id],onDelete: Cascade)
  especialidade Especialidade @relation(fields: [especialidadeId],references: [id],onDelete: Cascade)

  @@id([prestadorId, especialidadeId])
}

model PrestadorProcedimento {
  prestadorId   Int
  procedimentoId Int

  prestador Prestador @relation(fields: [prestadorId],references: [id],onDelete: Cascade)
  procedimento Procedimento @relation(fields: [procedimentoId],references: [id],onDelete: Cascade)

  @@id([prestadorId, procedimentoId])
}

model AgendamentoDePrestador {
  id Int @id @default(autoincrement())

  data DateTime @db.Date

  prestadorId Int
  prestador Prestador @relation(fields: [prestadorId],references: [id])

  unidadeDeAtendimentoId Int
  unidadeDeAtendimento Local @relation(fields: [unidadeDeAtendimentoId],references: [id])

  periodo PeriodoDeAtendimento
  salaNumero Int
  observacoes String?

  criadoPorId String?
  criadoPor Usuario? @relation(fields: [criadoPorId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([data, unidadeDeAtendimentoId, salaNumero, periodo])
}


model Paciente {
  id Int @id @default(autoincrement())

  tipoDeCadastro TipoDeCadastroPaciente @default(COMPLETO)

  nomeDoPaciente String
  nomeSocial String?
  nomeDaMae String?
  nomeDoPai String?
  dataDeNascimento DateTime @db.Date
  sexo Sexo
  estadoCivil EstadoCivil?
  corERaca Raca?

  unidadeDeSaudeId Int
  codigoGSUS String?
  codigoIDS String?
  tipoSanguineo TipoSanguineo?
  fatorRH FatorRH?

  nacionalidade String?
  municipioDeNascimento String?
  ufDeNascimento  UF?

  CPF String? @unique
  cartaoDoSus String? @unique
  NIS String?
  RG String?
  orgaoEmissorDoRG String?
  ufDoRG UF?
  dataDaEmissaoDoRG DateTime? @db.Date
  cnsMae String?
  orientacaoRegCpf String?
  tituloDeEleitor String?
  zonaEleitoral String?
  secaoEleitoral String?

  CTPSNumero String?
  CTPSSerie String?
  cTPSUf UF?
  CTPSDataEmissao DateTime? @db.Date
  PISPASEP String?

  frequentaEscola String?
  escola String?
  serieEscolar String?
  grauEscolaridade GrauDeEscolaridade?
  cursoProfissionalizante String?

  paisDeOrigem String?
  entradaNoBrasil DateTime? @db.Date

  email String?
  telefone String?
  telefoneWhatsApp String?
  nomeContatoEmergencia String?
  parentescoContatoEmergencia String?
  telefoneDeEmergencia String?

  nomeDoResponsavel String?
  CPFDoResponsavel String?
  parentescoDoResponsavel String?
  telefoneDoResponsavel String?

  pais String?
  UF UF?
  municipio String?
  bairro String?
  rua String?
  numero String?
  complemento String?
  CEP String?
  tipoLogradouro TipoDeLogradouro?
  pontoDeReferencia String?
  latitude Float?
  longitude Float?
  zona Zona?

  possuiDeficiencia Boolean @default(false)
  tipoDeDeficiencia Deficiencia[] @default([])
  observacoes String?

  ativo Boolean @default(true)

  unidadeDeSaude Local @relation(fields: [unidadeDeSaudeId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([nomeDoPaciente])
  @@index([dataDeNascimento])
  @@index([unidadeDeSaudeId])
  @@index([tipoDeCadastro])
}