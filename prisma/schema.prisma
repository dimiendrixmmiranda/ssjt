// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ESTAGIARIO
}

enum CategoriaAtendimento {
  CONSULTA
  PROCEDIMENTO
  CIRURGIA
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  SEPARADO
  UNIAO_ESTAVEL
}

enum CorRaca {
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  NAO_INFORMADO
}

enum TipoSanguineo {
  A
  B
  AB
  O
}

enum FatorRh {
  POSITIVO
  NEGATIVO
}

enum SimNao {
  SIM
  NAO
}

enum OrgaoEmissor {
  SSP
  DETRAN
  POLICIA_CIVIL
  OUTRO
}

enum GrauEscolaridade {
  FUNDAMENTAL_INCOMPLETO
  FUNDAMENTAL_COMPLETO
  MEDIO_INCOMPLETO
  MEDIO_COMPLETO
  SUPERIOR_INCOMPLETO
  SUPERIOR_COMPLETO
  POS_GRADUACAO
  MESTRADO
  DOUTORADO
}

enum Pais {
  BRASIL
  OUTRO
}

enum Zona {
  URBANA
  RURAL
}

enum TipoLocal {
  POSTO_DE_SAUDE
  CLINICA
  HOSPITAL
}

enum StatusLocal {
  ATIVO
  INATIVO
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      Role     
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TipoAtendimento {
  id          String                 @id @default(cuid())
  nome        String
  categoria   CategoriaAtendimento
  ativo       Boolean                @default(true)
  codigo      String @unique
  descricao   String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  locais LocalTipoAtendimento[]

  @@index([categoria])
  @@index([ativo])
}

model Medico {
  id              String   @id @default(cuid())
  nome            String
  crm             String   @unique
  especialidadeId String
  ativo           Boolean  @default(true)
  descricao       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([especialidadeId])
  @@index([ativo])
}


model Paciente {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nome                         String
  nomeSocial                   String?
  declaroNaoPossuirNomeSocial  Boolean @default(false)
  nomeDaMae                    String
  nomeDoPai                    String?
  dataDeNascimento             DateTime
  sexo                         Sexo?
  estadoCivil                  EstadoCivil?
  corRaca                      CorRaca?
  cpf                          String   @unique
  cartaoSus                    String?
  codigoGsus                   String?
  codigoIds                    String?
  nis                          String?
  unidadeDeSaude               String?
  tipoSanguineo                TipoSanguineo?
  fatorRh                      FatorRh?
  situacaoFamiliar             String?
  povoTradicional              String?
  religiao                     String?
  observacoes                  String?

  rg                           String?
  orgaoEmissor                 OrgaoEmissor?
  ufRg                         String?
  dataEmissaoRg                DateTime?

  cpfRegular                   SimNao?
  cpfCns                       String?
  cnsMae                       String?
  orientacaoRegCpf             SimNao?

  tituloEleitor                String?
  zonaEleitoral                String?
  secaoEleitoral               String?

  ctpsNumero                   String?
  ctpsSerie                    String?
  ctpsUf                       String?
  ctpsDataEmissao              DateTime?
  pisPasep                     String?

  frequentaEscola              SimNao?
  escola                       String?
  serieEscolar                 String?
  grauEscolaridade             GrauEscolaridade?
  cursoProfissionalizante      String?

  paisOrigem                   String?
  entradaBrasil                DateTime?
  numeroPortaria               String?
  dataNaturalizacao            DateTime?

  pais                         Pais?
  uf                           String?
  municipio                    String?
  bairro                       String?
  rua                          String?
  numero                       String?
  complemento                  String?
  zona                         Zona?

  latitude                     Float?
  longitude                    Float?
}

model Local {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nome        String
  tipoDoLocal TipoLocal
  status      StatusLocal @default(ATIVO)

  cidade      String
  cep         String?
  rua         String?
  numero      String?
  bairro      String?
  complemento String?

  telefone1 String?
  telefone2 String?
  email     String?

  descricao String?

  tiposDeAtendimento LocalTipoAtendimento[]

  @@index([nome])
  @@index([cidade])
  @@index([status])
}

model LocalTipoAtendimento {
  id String @id @default(cuid())

  localId           String
  tipoAtendimentoId String

  local           Local           @relation(fields: [localId], references: [id], onDelete: Cascade)
  tipoAtendimento TipoAtendimento @relation(fields: [tipoAtendimentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([localId, tipoAtendimentoId])
  @@index([localId])
  @@index([tipoAtendimentoId])
}